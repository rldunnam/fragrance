diff --git a/.devcontainer/devcontainer.json b/.devcontainer/devcontainer.json
index ebb2f78..fd8ec4c 100644
--- a/.devcontainer/devcontainer.json
+++ b/.devcontainer/devcontainer.json
@@ -14,12 +14,19 @@
   "image": "mcr.microsoft.com/devcontainers/universal:2-linux",
 
   "features": {
-    // Node 22 to match `FROM node:22-alpine` in the Dockerfile. Without this
+    // Node 24 to match `FROM node:24-alpine` in the Dockerfile. Without this
     // pin a rebuild falls back to the image default, which is how a v20
     // runtime appeared and broke pnpm 11 (it needs the node:sqlite builtin,
     // added in Node 22).
+    //
+    // 24 is Active LTS through April 2028. 26 is still Current until its
+    // October 2026 LTS promotion, so it does not belong in an image that
+    // serves traffic. The Node major is pinned in five places and they all
+    // move as a unit: here, both FROM lines in the Dockerfile, the CI
+    // setup-node step, `engines` in package.json, and the @types/node
+    // ceiling in .github/dependabot.yml.
     "ghcr.io/devcontainers/features/node:2": {
-      "version": "22"
+      "version": "24"
     }
   },
 
diff --git a/.github/dependabot.yml b/.github/dependabot.yml
index e3044a9..62cd27f 100644
--- a/.github/dependabot.yml
+++ b/.github/dependabot.yml
@@ -89,11 +89,15 @@ updates:
           - "minor"
           - "patch"
 
-    # Recharts v3 is a deliberate deferral with known breaking API changes.
-    # Uncomment to stop Dependabot reopening a PR you intend to handle by hand.
-    # ignore:
-    #   - dependency-name: "recharts"
-    #     update-types: ["version-update:semver-major"]
+    ignore:
+      # @types/node describes the runtime, so it must not float ahead of it.
+      # The runtime is Node 24 (Dockerfile, devcontainer feature, CI
+      # setup-node, `engines`); typing against a newer lib surface would let
+      # tsc accept APIs that do not exist at runtime and fail in production
+      # rather than in CI. Raise this ceiling in the same PR that raises the
+      # runtime, never on its own.
+      - dependency-name: "@types/node"
+        versions: [">=25"]
 
   # ---------------------------------------------------------------------------
   # Dev container
