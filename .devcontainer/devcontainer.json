{
  "name": "fragrance",

  // Codespaces' universal image, NOT a language-specific one.
  //
  // The typescript-node images run as user `node` with home /home/node, while
  // Codespaces' own first-run tooling assumes user `codespace` and
  // /home/codespace. Mixing them produces:
  //   mkdir: cannot create directory '/home/codespace': Permission denied
  //
  // Pinning Node through a feature instead gets the same version guarantee
  // without changing the user, the home directory, or anything else Codespaces
  // has already set up.
  "image": "mcr.microsoft.com/devcontainers/universal:2-linux",

  "features": {
    // Node 22 to match `FROM node:22-alpine` in the Dockerfile. Without this
    // pin a rebuild falls back to the image default, which is how a v20
    // runtime appeared and broke pnpm 11 (it needs the node:sqlite builtin,
    // added in Node 22).
    "ghcr.io/devcontainers/features/node:2": {
      "version": "22"
    }
  },

  "containerEnv": {
    // Let corepack fetch the pinned pnpm without an interactive prompt,
    // which would otherwise hang postCreateCommand.
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0"
  },

  // corepack reads `packageManager` from package.json, so pnpm resolves to
  // exactly 11.15.1 rather than whatever a global install happens to be.
  // Same mechanism the Dockerfile's base stage uses.
  "postCreateCommand": "corepack enable && pnpm install --frozen-lockfile",

  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "next dev",
      "onAutoForward": "notify"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "ms-azuretools.vscode-docker",
        "github.vscode-github-actions"
      ],
      "settings": {
        "eslint.useFlatConfig": true,
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  }

  // No "remoteUser" and no github-cli feature: the universal image already
  // provides the codespace user and the gh CLI.
}
