# Copy to .env.local and fill in. All three are required.
#
# These are NEXT_PUBLIC_* and are inlined into the client bundle at BUILD time.
# Changing them requires restarting `pnpm dev` or rebuilding the image.
#
# All three are public by design. Never put the Supabase service_role key here.

# Clerk dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# Supabase -> Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Supabase -> Settings -> API -> anon / public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# Reminder: Clerk also needs a JWT template named exactly "supabase".
# See README -> Clerk JWT template.
